  "council": {
    "default_preset": "balanced",
    "timeout": 300000,
    "councillor_execution_mode": "parallel",
    "councillor_retries": 1,
    "presets": {
      "balanced": {
        "reviewer": {
          "model": "opencode-go/deepseek-v4-pro",
          "variant": "high",
          "prompt": "Focus on correctness, bugs, edge cases, concurrency hazards, hidden assumptions, and failure modes. Be concrete and adversarial."
        },
        "implementer": {
          "model": "opencode-go/deepseek-v4-pro",
          "variant": "thinking",
          "prompt": "Focus on implementation feasibility, code structure, minimal changes, API fit, testability, and whether the proposed plan is practical to implement."
        },
        "architect": {
          "model": "openai/gpt-5.5",
          "variant": "medium",
          "prompt": "Focus on architecture, abstraction boundaries, maintainability, long-term design risk, coupling, and whether the solution will age well."
        },
        "systems": {
          "model": "opencode-go/glm-5.2",
          "prompt": "Focus on systems reasoning, invariants, resource trade-offs, concurrency, performance, and low-level implications."
        },
        "optimizer": {
          "model": "opencode-go/deepseek-v4-pro",
          "prompt": "Focus on performance, latency, memory usage, resource usage, scalability, and systems-level trade-offs."
        }
      },
      "go-only": {
        "reviewer": {
          "model": "opencode-go/deepseek-v4-pro",
